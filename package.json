{
  "name": "wedding-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "predev": "pnpm db:generate && pnpm images:prepare --allow-missing-sources",
    "dev": "next dev",
    "prebuild": "pnpm db:generate",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pretypecheck": "pnpm db:generate",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm db:generate",
    "test": "vitest run",
    "pretest:watch": "pnpm db:generate",
    "test:watch": "vitest",
    "pretest:coverage": "pnpm db:generate",
    "test:coverage": "vitest run --coverage",
    "pretest:db": "pnpm db:generate",
    "test:db": "vitest run --config vitest.database.config.mts",
    "pretest:e2e": "pnpm db:generate",
    "test:e2e": "playwright test",
    "admin:credentials": "tsx scripts/admin-credentials.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "images:prepare": "tsx scripts/images/cli.ts prepare",
    "images:sync": "tsx scripts/images/cli.ts sync",
    "images:prune": "tsx scripts/images/cli.ts prune",
    "vercel:setup": "bash scripts/setup-vercel.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "prisma": "^7.9.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
