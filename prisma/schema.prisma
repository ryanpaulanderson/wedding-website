generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AttendanceResponse {
  ATTENDING @map("attending")
  DECLINED  @map("declined")

  @@map("attendance_response")
}

model Household {
  id                  String    @id @default(uuid()) @db.Uuid
  displayName         String    @map("display_name")
  invitationTokenHash String?   @unique @map("invitation_token_hash") @db.VarChar(64)
  firstRespondedAt    DateTime? @map("first_responded_at") @db.Timestamptz(3)
  lastRespondedAt     DateTime? @map("last_responded_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  guests              Guest[]

  @@index([lastRespondedAt(sort: Desc)])
  @@map("households")
}

model Guest {
  id                         String              @id @default(uuid()) @db.Uuid
  householdId                String              @map("household_id") @db.Uuid
  displayName                String              @map("display_name")
  attendance                 AttendanceResponse?
  dietaryRestrictions        String?             @map("dietary_restrictions") @db.VarChar(1000)
  plusOneAllowed             Boolean             @default(false) @map("plus_one_allowed")
  plusOneName                String?             @map("plus_one_name") @db.VarChar(200)
  plusOneAttendance          AttendanceResponse? @map("plus_one_attendance")
  plusOneDietaryRestrictions String?             @map("plus_one_dietary_restrictions") @db.VarChar(1000)
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  household                  Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([attendance])
  @@map("guests")
}

enum EarlyDeclineEmailKind {
  GUEST_CONFIRMATION
  ADMIN_NOTIFICATION
}

enum EarlyDeclineEmailStatus {
  PENDING
  ACCEPTED
  FAILED
  PAUSED
  NEEDS_REVIEW
}

model EarlyDecline {
  id         String              @id @default(uuid()) @db.Uuid
  names      String              @db.VarChar(1000)
  email      String              @unique @db.VarChar(254)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedAt DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  emails     EarlyDeclineEmail[]

  @@index([createdAt(sort: Desc)])
  @@map("early_declines")
}

model EarlyDeclineEmail {
  id             String                  @id @default(uuid()) @db.Uuid
  declineId      String                  @map("decline_id") @db.Uuid
  kind           EarlyDeclineEmailKind
  status         EarlyDeclineEmailStatus @default(PENDING)
  payload        String?
  attempts       Int                     @default(0)
  firstAttemptAt DateTime?               @map("first_attempt_at") @db.Timestamptz(3)
  leaseToken     String?                 @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime?               @map("lease_expires_at") @db.Timestamptz(3)
  providerId     String?                 @map("provider_id") @db.VarChar(36)
  errorCode      String?                 @map("error_code") @db.VarChar(40)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  decline        EarlyDecline            @relation(fields: [declineId], references: [id], onDelete: Cascade)

  @@unique([declineId, kind])
  @@index([status])
  @@map("early_decline_emails")
}

model EarlyDeclineRateLimit {
  key       String   @id @db.VarChar(64)
  attempts  Int      @default(1)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("early_decline_rate_limits")
}
